<script>
(function(){
  var selector=document.getElementById('graph-relation');
  var groups=document.querySelectorAll('#model-graph [data-relation]');
  var caption=document.getElementById('graph-caption');
  var descriptions={g2m:'Grid → mesh 0: grid embeddings are aggregated by mean at fine-mesh receivers.',m0:'Within mesh 0: each layer combines messages from neighboring fine-mesh nodes by sum.',up:'Mesh 0 → mesh 1: encoder/prior use mean; decoder uses sum and a latent-initialized receiver.',m1:'Within mesh 1: messages combine coarse-node information by sum. No additional upward pass is inserted between these layers.',down:'Mesh 1 → mesh 0: decoder mean propagation updates the saved fine-mesh receiver states.',m2g:'Mesh 0 → grid: sum aggregation updates grid receivers that contain the direct grid skip.'};
  if(!selector||!groups.length||!caption)return;
  selector.addEventListener('change',function(){
    var key=selector.value;
    groups.forEach(function(g){g.setAttribute('display',g.getAttribute('data-relation')===key?'inline':'none');});
    caption.textContent=descriptions[key]+' Blue/green nodes have different owners; orange edges need halos. This is a schematic subset.';
  });
  document.documentElement.classList.add('js');
})();
</script></body></html>
